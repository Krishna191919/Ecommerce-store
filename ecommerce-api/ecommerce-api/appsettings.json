{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ecommerce.db"
  },
  "Jwt": {
    "Issuer": "EcommerceStore",
    "Audience": "EcommerceStoreUsers",
    "ExpiresInDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
